<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#171717">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_facebook"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                app:srcCompat="@drawable/logo"
                android:contentDescription="@string/logo" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                app:backgroundTint="@color/orange_btn"
                app:cornerRadius="30dp"
                android:text="@string/activate_bluetooth"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Section Custom Rainbow -->
            <LinearLayout
                android:id="@+id/layout_rainbow_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#222222"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_rainbow"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_rainbow_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Panneau extensible (Caché par défaut) -->
            <LinearLayout
                android:id="@+id/layout_rainbow_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <com.skydoves.colorpickerview.ColorPickerView
                    android:id="@+id/color_picker"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    app:palette="@drawable/color_circle_rgb" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brightness"
                    android:textColor="#BBBBBB" />

                <SeekBar
                    android:id="@+id/seek_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/white_channel"
                    android:textColor="#BBBBBB" />

                <SeekBar
                    android:id="@+id/seek_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btn_start_rainbow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    android:text="@string/launch"
                    app:backgroundTint="@color/orange_btn" />

            </LinearLayout>

            <!-- Section Custom Fade -->
            <LinearLayout
                android:id="@+id/layout_fade_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#222222"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_fade"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/iv_fade_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#FFFFFF" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_fade_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fade_description"
                    android:textColor="#BBBBBB" />
                <Button
                    android:id="@+id/btn_start_fade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/launch"
                    app:backgroundTint="@color/orange_btn" />
            </LinearLayout>

            <!-- Section Custom Fire Breath -->
            <LinearLayout
                android:id="@+id/layout_fire_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#222222"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_fire_breath"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/iv_fire_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#FFFFFF" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_fire_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fire_description"
                    android:textColor="#BBBBBB" />
                <Button
                    android:id="@+id/btn_start_fire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/launch"
                    app:backgroundTint="@color/orange_btn" />
            </LinearLayout>

            <!-- Section Custom Text -->
            <LinearLayout
                android:id="@+id/layout_text_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#222222"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/custom_text"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/iv_text_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#FFFFFF" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_text_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1A1A1A"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <EditText
                    android:id="@+id/et_custom_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_text"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:backgroundTint="#444444" />
                <Button
                    android:id="@+id/btn_send_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/send"
                    app:backgroundTint="@color/orange_btn" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Boutons sociaux en bas -->
    <ImageButton
        android:id="@+id/btn_facebook"
        style="@style/SocialButton"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/facebook"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_instagram"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/facebook" />

    <ImageButton
        android:id="@+id/btn_instagram"
        style="@style/SocialButton"
        android:contentDescription="@string/instagram"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_youtube"
        app:layout_constraintStart_toEndOf="@+id/btn_facebook"
        app:srcCompat="@drawable/instagram" />

    <ImageButton
        android:id="@+id/btn_youtube"
        style="@style/SocialButton"
        android:contentDescription="@string/youtube"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_tiktok"
        app:layout_constraintStart_toEndOf="@+id/btn_instagram"
        app:srcCompat="@drawable/youtube" />

    <ImageButton
        android:id="@+id/btn_tiktok"
        style="@style/SocialButton"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/tiktok"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_youtube"
        app:srcCompat="@drawable/tic" />

</androidx.constraintlayout.widget.ConstraintLayout>